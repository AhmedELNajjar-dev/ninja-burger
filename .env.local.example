# =============================================================
# NINJA BURGER — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================

# ── Supabase ──────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key — used ONLY in server-side API routes.
# NEVER expose this to the client (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Discord Webhook (100% Free Order Notifications) ───────────
# Setup steps:
# 1. Open Discord → Your server → any text channel
# 2. Click the gear icon on the channel → Integrations → Webhooks
# 3. Click "New Webhook" → give it a name (e.g. "🍔 طلبات نينجا")
# 4. Click "Copy Webhook URL" and paste it below
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional: Distributed Rate Limiting (Upstash Redis) ────────
# Free tier from https://upstash.com
# If omitted, built-in memory sliding window limiter is automatically used.
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

